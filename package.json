{
  "name": "nilaza",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:dev": "npm --workspace apps/web run dev --",
    "web:check": "npm --workspace apps/web run check",
    "web:build": "npm --workspace apps/web run build",
    "validate:public-content": "node scripts/validate-public-content.mjs && node scripts/build-public-help-corpus.mjs --check",
    "public-help-corpus:build": "node scripts/build-public-help-corpus.mjs",
    "public-help-corpus:check": "node scripts/build-public-help-corpus.mjs --check",
    "admin:dev": "node scripts/serve-admin.mjs",
    "admin:owner-guide": "node scripts/build-admin-owner-guide.mjs",
    "admin:seed": "node scripts/build-admin-seed.mjs",
    "admin:check": "node scripts/validate-admin-workflow-catalog.mjs && node scripts/build-prompt-consumers.mjs --check && node scripts/build-admin-seed.mjs --check && node scripts/build-admin-growth.mjs --check && node scripts/build-admin-owner-guide.mjs --check && node scripts/validate-admin-contract.mjs",
    "prompt:consumers:generate": "node scripts/build-prompt-consumers.mjs",
    "prompt:consumers:check": "node scripts/build-prompt-consumers.mjs --check",
    "admin:growth:check": "node scripts/build-admin-growth.mjs --check",
    "admin:growth:seed": "node scripts/build-admin-growth.mjs",
    "admin:growth:seed": "node scripts/build-admin-growth.mjs",
    "admin:test": "node --test scripts/admin-content-model.test.mjs scripts/admin-content-sync.test.mjs scripts/admin-content-render.test.mjs scripts/admin-ai-studio-render.test.mjs scripts/admin-workflow-catalog.test.mjs scripts/admin-growth-render.test.mjs scripts/admin-growth-operations.test.mjs scripts/admin-access.test.mjs scripts/admin-shell-state.test.mjs scripts/admin-recovery.test.mjs scripts/admin-feedback.test.mjs scripts/admin-feature-switches.test.mjs scripts/admin-env-band.test.mjs scripts/admin-small-fixes.test.mjs scripts/admin-a1-cleanup.test.mjs scripts/admin-a2-navigation.test.mjs scripts/admin-a3-content.test.mjs scripts/admin-a5-prompts.test.mjs scripts/admin-a6-evals.test.mjs scripts/admin-a7-providers.test.mjs scripts/admin-team-roles.test.mjs scripts/admin-context-config.test.mjs scripts/admin-ai-cost.test.mjs scripts/admin-model-campaigns.test.mjs",
    "ai-operations:test": "node --test scripts/model-route-publish-sql.test.mjs scripts/ai-answer-endpoints.test.mjs scripts/ai-feedback-sql.test.mjs scripts/supabase-model-campaigns.test.mjs scripts/tarot-note-claim-sql.test.mjs",
    "mobile:dev": "npm --workspace apps/mobile run dev --",
    "mobile:web": "npm --workspace apps/mobile run web --",
    "mobile:check": "npm --workspace apps/mobile run check",
    "validate:visual-assets": "node scripts/validate-visual-assets.mjs && node scripts/validate-mobile-runtime-assets.mjs",
    "assets:generate": "node scripts/generate-brand-assets.mjs",
    "validate:mobile-export": "node scripts/validate-mobile-export.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:astrology": "node scripts/validate-astrology-foundation.mjs && node scripts/validate-astrology-mythology.mjs",
    "validate:backend": "node scripts/validate-backend-contracts.mjs",
    "council:contract:generate": "node scripts/generate-council-contract.mjs",
    "council:contract:check": "node scripts/generate-council-contract.mjs --check",
    "validate:governance": "node scripts/validate-agent-governance.mjs",
    "feature:preflight": "node scripts/feature-preflight.mjs",
    "feature:preflight:test": "node --test scripts/feature-preflight.test.mjs",
    "feature:run": "node scripts/feature-run.mjs",
    "feature:run:test": "node --test scripts/feature-run.test.mjs",
    "growth:validate": "node scripts/validate-growth-pilot.mjs",
    "growth:validate:portable": "node scripts/validate-growth-framework.mjs",
    "growth:test": "node --test scripts/growth-pilot-config.test.mjs",
    "growth:test:portable": "node --test scripts/growth-framework.test.mjs",
    "growth:tenant:test": "node --test scripts/growth-tenant-onboarding.test.mjs scripts/growth-tenant-artifacts.test.mjs scripts/growth-job-preparation.test.mjs scripts/growth-two-tenant-demo.test.mjs scripts/growth-tenant-learning-export.test.mjs",
    "growth:tenant:demo": "node scripts/validate-growth-tenant-demo.mjs",
    "growth:tenant:artifact:validate": "node scripts/validate-growth-tenant-artifacts.mjs",
    "growth:tenant:job:prepare": "node scripts/prepare-growth-job.mjs",
    "growth:tenant:two:validate": "node scripts/growth-two-tenant-demo.mjs",
    "growth:tenant:learning:validate": "node scripts/validate-growth-tenant-learning-export.mjs",
    "growth:tenant:learning:compare": "node scripts/compare-growth-tenant-learning-exports.mjs",
    "growth:tenant:learning:demo": "node scripts/growth-tenant-learning-demo.mjs",
    "growth:export:dry-run": "node scripts/export-growth-framework.mjs --dry-run --source-boundary packages/growth-nilaza/readiness/sprint-01-readiness.json",
    "supabase:migration-ledger:check": "node scripts/check-supabase-migration-ledger.mjs",
    "mobile:release:manifest": "node scripts/generate-mobile-release-manifest.mjs",
    "mobile:release:config:check": "node scripts/validate-mobile-release-config.mjs",
    "e2e:ai-council:staging": "node scripts/e2e-ai-council-staging.mjs",
    "supabase:check": "node scripts/check-supabase-readiness.mjs",
    "supabase:seed:generate": "node scripts/generate-supabase-seed.mjs",
    "supabase:seed:verify": "node scripts/apply-supabase-seed.mjs --dry-run",
    "supabase:seed:apply": "node scripts/apply-supabase-seed.mjs",
    "validate:brand": "node scripts/validate-brand.mjs",
    "validate:launch": "node scripts/validate-launch.mjs",
    "skills:sync": "node scripts/sync-project-skills.mjs",
    "skills:validate": "node scripts/validate-repo-skills.mjs",
    "skills:check": "node scripts/sync-project-skills.mjs --check",
    "astrology:core:test": "npm --workspace packages/astrology-core test",
    "astrology:accuracy:check": "node scripts/validate-astrology-accuracy.mjs",
    "astrology:contract:check": "node scripts/generate-astrology-contract.mjs --check",
    "astrology:grid:check": "node scripts/validate-astrology-chart-grid.mjs",
    "astrology:ai-contract:check": "node scripts/validate-astrology-ai-contract.mjs",
    "astrology:ai-contract:test": "node --test scripts/astrology-ai-contract.test.mjs",
    "astrology:ai-contract:generate": "node scripts/generate-astrology-ai-contract.mjs",
    "astrology:ai-contract:runtime-check": "node scripts/generate-astrology-ai-contract.mjs --check"
  },
  "devDependencies": {
    "deno": "^2.9.0",
    "supabase": "^2.108.0",
    "sharp": "^0.34.5",
    "ajv": "8.17.1"
  }
}
