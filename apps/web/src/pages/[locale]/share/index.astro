---
// The address every share link used before 28/11/2026. It keeps working: the variant is read from utm_campaign in
// the browser. New links open /share/card, /share/reading, /share/numbers or /share/sky, which have their own previews.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ShareLanding from "../../../components/share/ShareLanding.astro";
import { locales, type Locale } from "../../../lib/site";
import { shareMeta } from "../../../lib/shareLanding";
export function getStaticPaths() { return locales.map(locale => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props as { locale: Locale };
const { title, description } = shareMeta(locale, "auto");
---
<BaseLayout {locale} {title} {description} waitlistTarget="#join">
  <ShareLanding {locale} variant="auto" />
</BaseLayout>
