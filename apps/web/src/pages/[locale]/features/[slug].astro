---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WaitlistForm from "../../../components/WaitlistForm.astro";
import { featureCopy, locales, type Locale } from "../../../lib/site";
import { featureWorkflows } from "../../../lib/featureWorkflows";
import mythologyCapture from "../../../../../../assets/features/web-product/mythology-android-vi.png";
import oracleImage from "../../../../../../assets/features/oracle.png";
import councilImage from "../../../../../../assets/features/ai-council.png";
import tarotImage from "../../../../../../assets/features/tarot.png";
import journalImage from "../../../../../../assets/features/journal.png";
import astrologyImage from "../../../../../../assets/features/astrology.png";
const images = { oracle: oracleImage, "ai-council": councilImage, tarot: tarotImage, journal: journalImage, astrology: astrologyImage };
export function getStaticPaths() { return locales.flatMap(locale => featureCopy[locale].map(feature => ({ params: { locale, slug: feature.slug }, props: { locale, feature } }))); }
const { locale, feature } = Astro.props as { locale: Locale; feature: (typeof featureCopy)[Locale][number] };
const vi = locale === "vi";
const steps = featureWorkflows[locale][feature.slug];
---
<BaseLayout {locale} title={`${feature.title} — Nilaza`} description={feature.description} waitlistTarget="#waitlist">
  <section class="feature-hero"><div class="shell feature-grid"><div><a class="back" href={`/${locale}#features`}>← {vi ? "Tất cả tính năng" : "All features"}</a><p class="eyebrow">{feature.eyebrow}</p><h1 class="display">{feature.title}</h1><p class="lead">{feature.description}</p><span class:list={["status", feature.status]}>{feature.status === "available" ? (vi ? "Đã có trong bản thử nghiệm" : "Available in beta") : (vi ? "Đang hoàn thiện" : "Being refined")}</span></div><img src={images[feature.image].src} alt="" /></div></section>
  <section class="section paper"><div class="shell"><p class="eyebrow">{vi ? "Cách trải nghiệm diễn ra" : "How the experience flows"}</p><h2 class="section-title">{vi ? "Nhẹ nhàng, có chủ đích, luôn để bạn tự quyết." : "Gentle, intentional, and always yours to decide."}</h2><div class="steps">{steps.map((step, index) => <article class="card"><span>0{index + 1}</span><p>{step}</p></article>)}</div></div></section>
  {feature.slug === "astrology" && <section class="section"><div class="shell astrology-proof"><div><p class="eyebrow">{vi ? "Đã có trong bản thử nghiệm" : "Integrated in the test build"}</p><h2 class="section-title">{vi ? "Bản đồ của bạn. Câu chuyện của 12 cung." : "Your chart. The stories of 12 signs."}</h2><p>{vi ? "Bản đồ cá nhân được tính trên thiết bị trước khi diễn giải. Thư viện thần thoại và hướng dẫn 12 cung có thể khám phá riêng, không yêu cầu hồ sơ sinh." : "Personal charts are calculated on the device before interpretation. Explore mythology and sign guides separately, without a birth profile."}</p><p>{vi ? "Bản đồ đã lưu cục bộ không đồng nghĩa đã đồng bộ lên đám mây. Quyền truy cập AI phụ thuộc tài khoản và trạng thái hiển thị trong ứng dụng; không phải cam kết mọi người đã có quyền dùng." : "A locally saved chart does not mean it has synced to the cloud. AI access depends on your account and the status shown in the app; it is not a promise of access for everyone."}</p><a class="button secondary" href={`/${locale}/help/astrology-premium`}>{vi ? "Chiêm tinh, dữ liệu & quyền truy cập" : "Astrology, data & access"} ↗</a></div><figure><img src={mythologyCapture.src} width="1080" height="2460" loading="lazy" alt={vi ? "Vòng 12 cung trong thư viện thần thoại Nilaza trên Android." : "Interactive zodiac wheel in Nilaza’s mythology library. Vietnamese interface."}/><figcaption>{vi ? "Ảnh thật · Android 0.1.3 · Giao diện VI · Bản thử nghiệm nội bộ" : "Real capture · Android 0.1.3 · Vietnamese UI · Internal test build"}</figcaption></figure></div></section>}
  <section class="section" id="waitlist"><div class="shell callout"><div><p class="eyebrow">{vi ? "Đăng ký trước ra mắt" : "Prelaunch waitlist"}</p><h2 class="section-title">{vi ? "Nhận tin ra mắt và cơ hội trải nghiệm sớm." : "Sign up for launch news and early access opportunities."}</h2></div><WaitlistForm {locale} /></div></section>
</BaseLayout>
<style>.feature-hero{padding:90px 0 110px}.feature-grid{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:center}.back{display:inline-block;margin-bottom:60px;color:var(--moon);font-size:.8rem;text-decoration:none}.feature-hero h1{font-size:clamp(4rem,10vw,8rem);margin:14px 0}.lead{max-width:650px;color:var(--moon)}.feature-hero img{width:100%;aspect-ratio:4/5;object-fit:cover}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:40px}.steps article{padding:24px}.steps span{color:var(--gold);font-family:var(--display)}.steps p{font:500 1.35rem var(--display)}.callout{display:grid;grid-template-columns:1fr 1fr;gap:70px}@media(max-width:760px){.feature-grid,.callout,.steps{grid-template-columns:1fr}.back{margin-bottom:35px}.feature-hero{padding:60px 0}.feature-hero img{aspect-ratio:16/10}}.astrology-proof{display:grid;grid-template-columns:1fr 320px;gap:60px;align-items:center}.astrology-proof p{color:var(--moon)}.astrology-proof figure{margin:0}.astrology-proof img{width:100%;height:auto;aspect-ratio:auto;border:1px solid var(--line);border-radius:8px}.astrology-proof figcaption{font-size:.72rem;color:var(--moon);margin-top:10px}@media(max-width:760px){.astrology-proof{grid-template-columns:1fr;gap:28px}.astrology-proof figure{max-width:320px;margin:auto}.feature-hero h1{font-size:clamp(2.8rem,12vw,4.4rem)}} </style>
