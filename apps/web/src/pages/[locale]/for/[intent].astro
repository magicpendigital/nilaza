---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WaitlistForm from "../../../components/WaitlistForm.astro";
import { intentions, locales, type Locale } from "../../../lib/site";
import oracleImage from "../../../../../../assets/features/oracle.png";
export function getStaticPaths() { return locales.flatMap(locale => intentions[locale].map(item => ({ params: { locale, intent: item.slug }, props: { locale, item } }))); }
const { locale, item } = Astro.props as { locale: Locale; item: (typeof intentions)[Locale][number] };
const vi = locale === "vi";
---
<BaseLayout {locale} title={`${item.label} — Nilaza`} description={item.prompt} waitlistTarget="#join">
  <section class="intent-hero"><div class="shell intent-grid"><div><p class="eyebrow">Nilaza Oracle</p><h1 class="display">{item.label}</h1><p class="prompt">“{item.prompt}”</p><p class="example-label">{vi ? "Ví dụ soạn sẵn · Không phải phiên AI trực tiếp" : "Prewritten example · Not a live AI session"}</p><p class="response">{item.response}</p><a class="button" href="#join">{vi ? "Đăng ký trước ra mắt" : "Join the waitlist"}</a></div><img src={oracleImage.src} alt="" /></div></section>
  <section class="section paper"><div class="shell boundary"><div><p class="eyebrow">{vi ? "Một cách tiếp cận khác" : "A different approach"}</p><h2 class="section-title">{vi ? "Không đoán thay bạn. Cùng bạn nhìn rõ hơn." : "Not deciding for you. Helping you see more clearly."}</h2></div><div><p>{vi ? "Nilaza giúp gọi tên cảm xúc, tách dữ kiện khỏi giả định và đề xuất một câu hỏi hoặc bước nhỏ an toàn. Bạn luôn giữ quyền quyết định." : "Nilaza helps name feelings, separate facts from assumptions, and suggest one safe question or small step. You always keep the decision."}</p><a href={`/${locale}/safety`}>{vi ? "Xem nguyên tắc an toàn" : "See our safety principles"} →</a></div></div></section>
  <section class="section" id="join"><div class="shell join"><div><p class="eyebrow">{vi ? "Đăng ký trước ra mắt" : "Prelaunch waitlist"}</p><h2 class="section-title">{vi ? "Nhận tin khi Nilaza ra mắt." : "Hear when Nilaza launches."}</h2></div><WaitlistForm {locale} /></div></section>
</BaseLayout>
<style>.intent-hero{padding:90px 0 110px;background:radial-gradient(circle at 25% 20%,rgba(14,90,90,.45),transparent 32%)}.intent-grid{display:grid;grid-template-columns:1fr .7fr;gap:80px;align-items:center}.intent-hero h1{font-size:clamp(4rem,10vw,8.5rem);margin:14px 0}.prompt{max-width:700px;font:500 1.7rem/1.25 var(--display);color:var(--gold)}.response{max-width:620px;color:var(--moon);margin:24px 0 32px}.intent-hero img{width:100%;aspect-ratio:4/5;object-fit:cover}.boundary,.join{display:grid;grid-template-columns:1fr 1fr;gap:80px}.boundary>div:last-child{padding-top:45px}.boundary a{color:var(--teal);text-decoration:none}.paper .eyebrow{color:var(--teal)}@media(max-width:760px){.intent-grid,.boundary,.join{grid-template-columns:1fr}.intent-hero img{aspect-ratio:16/10}.intent-hero{padding:65px 0}.boundary>div:last-child{padding-top:0}}.example-label{font-size:.76rem;color:var(--moon)}@media(max-width:760px){.intent-hero h1{font-size:clamp(2.8rem,12vw,4.4rem)}} </style>
