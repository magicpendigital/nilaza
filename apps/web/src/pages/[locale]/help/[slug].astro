---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import type { Locale } from "../../../lib/site";
export async function getStaticPaths() { const items = await getCollection("help"); return items.map(article => ({ params: { locale: article.data.locale, slug: article.data.slug }, props: { article } })); }
const { article } = Astro.props as { article: Awaited<ReturnType<typeof getCollection<"help">>>[number] };
const locale = article.data.locale as Locale;
const vi = locale === "vi";
const { Content } = await render(article);
---
<BaseLayout {locale} title={`${article.data.title} — Nilaza Help`} description={article.data.description}>
  <section class="article-hero"><div class="shell"><a href={`/${locale}/help`}>← {vi ? "Trung tâm trợ giúp" : "Help center"}</a><p class="eyebrow">{article.data.category}</p><h1 class="display">{article.data.title}</h1><p>{article.data.description}</p><div><span class:list={["status", article.data.status]}>{article.data.status === "available" ? (vi ? "Sẵn sàng" : "Available") : article.data.status === "beta" ? "Beta" : (vi ? "Dự kiến" : "Planned")}</span><time datetime={article.data.updatedAt.toISOString()}>{vi ? "Cập nhật" : "Updated"} {article.data.updatedAt.toLocaleDateString(locale)}</time></div></div></section>
  <section class="section paper"><article class="shell prose" data-pagefind-body><Content /></article></section>
</BaseLayout>
<style>.article-hero{padding:40px 0}.article-hero a{color:var(--moon);font-size:.8rem;text-decoration:none}.article-hero .eyebrow{margin-top:24px}.article-hero h1{max-width:880px;font-size:clamp(2.5rem,5vw,4.5rem);margin:10px 0}.article-hero>div>p:not(.eyebrow){max-width:700px;color:var(--moon)}.article-hero>div>div{display:flex;align-items:center;gap:14px}.article-hero time{font-size:.75rem;color:var(--moon)}.paper .prose{color:var(--ink)}.paper .prose :global(a){color:var(--teal)}</style>
