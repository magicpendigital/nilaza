    "@fontsource/hanken-grotesk": "5.3.0",
    "astro": "7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "pagefind": "1.5.2",
    "typescript": "5.9.2",
    "wrangler": "^4.130.0"
  }
}
