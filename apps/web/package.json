{
  "name": "@nilaza/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build && pagefind --site dist && node ../../scripts/check-web-compatibility.mjs",
