{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nilaza Immutable Local Runtime Job",
  "description": "Actual persisted job.json shape from nilaza-local-session-runtime-v1. It captures canonical source byte hashes and semantic snapshot/seed hashes. Native validation verifies hashes and idempotency; run state is separate. This carousel-only runtime grants no external authority.",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "tenantId",
    "workflowId",
    "briefId",
    "createdAt",
    "runtimeVersion",
    "mode",
    "externalAction",
    "sourceMode",
    "identityKind",
    "idempotencyKey",
    "inputFingerprint",
    "sourceReferences",
    "inputSnapshotHash",
    "inputSeedHash",
    "inputArtifactReferences",
    "outputArtifactType",
    "allowedDataClasses",
    "format",
    "locales",
    "promptVersion",
    "qualityGateVersion",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "jobId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "tenantId": {
      "const": "nilaza"
    },
    "workflowId": {
      "const": "W2_content_factory"
    },
    "briefId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "pattern": "\\S"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d{3})?Z$"
    },
    "runtimeVersion": {
      "const": "nilaza-local-session-runtime-v1"
    },
    "mode": {
      "const": "draft_only"
    },
    "externalAction": {
      "const": "forbidden"
    },
    "sourceMode": {
      "enum": [
        "actual_ai_session_handback",
        "fixture"
      ]
    },
    "identityKind": {
      "const": "operator_attested_local_session_provenance"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9:_-]+$"
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "sourceReferences": {
      "type": "array",
      "minItems": 9,
      "maxItems": 300,
      "items": {
        "type": "object",
        "required": [
          "relativePath",
          "sha256"
        ],
        "properties": {
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "pattern": "^(?:packages|scripts|assets|docs)/(?!.*\\.\\.)(?!.*\\\\)[^\\r\\n]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "inputSnapshotHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inputSeedHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "inputArtifactReferences": {
      "type": "array",
      "minItems": 9,
      "maxItems": 300,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "pattern": "^(?:packages|scripts|assets|docs)/(?!.*\\.\\.)(?!.*\\\\)[^\\r\\n]+$"
      },
      "uniqueItems": true
    },
    "outputArtifactType": {
      "const": "concept_copy_package"
    },
    "allowedDataClasses": {
      "const": [
        "sanitized_tenant_config",
        "approved_public_research",
        "licensed_or_approved_asset_reference"
      ]
    },
    "format": {
      "const": "carousel"
    },
    "locales": {
      "const": [
        "vi",
        "en"
      ]
    },
    "promptVersion": {
      "const": "root-session-handback-v1"
    },
    "qualityGateVersion": {
      "const": "growth_core_1"
    },
    "limits": {
      "type": "object",
      "required": [
        "maxRenderRetries",
        "maxRepairCycles",
        "maxPacketBytes",
        "maxFileBytes",
        "maxBundleBytes"
      ],
      "properties": {
        "maxRenderRetries": {
          "const": 2
        },
        "maxRepairCycles": {
          "const": 2
        },
        "maxPacketBytes": {
          "const": 65536
        },
        "maxFileBytes": {
          "const": 16777216
        },
        "maxBundleBytes": {
          "const": 67108864
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
