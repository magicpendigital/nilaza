{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nilaza Internal Author Packet",
  "description": "Runtime accepts at most 65536 serialized bytes, exactly three bilingual slides and five copy fields per locale. Each text is bounded to 5000 characters. Research/strategy fields are optional and sourceRefs must resolve to the captured approved source register. Intake, QA, approval, state, command, URL and path authority fields are excluded. Content safety and byte limits are enforced by native validation.",
  "type": "object",
  "required": [
    "schemaVersion",
    "jobId",
    "briefId",
    "copy",
    "slides"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "jobId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9-]{2,79}$"
    },
    "briefId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 5000,
      "pattern": "\\S"
    },
    "copy": {
      "type": "object",
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "object",
          "required": [
            "headline",
            "body",
            "caption",
            "cta",
            "altText"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "cta": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "altText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        "en": {
          "type": "object",
          "required": [
            "headline",
            "body",
            "caption",
            "cta",
            "altText"
          ],
          "properties": {
            "headline": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "body": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "caption": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "cta": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            },
            "altText": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "slides": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "vi",
          "en"
        ],
        "properties": {
          "vi": {
            "type": "object",
            "required": [
              "headline",
              "body",
              "altText"
            ],
            "properties": {
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\S"
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\S"
              },
              "altText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          },
          "en": {
            "type": "object",
            "required": [
              "headline",
              "body",
              "altText"
            ],
            "properties": {
              "headline": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\S"
              },
              "body": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\S"
              },
              "altText": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "research": {
      "type": "object",
      "required": [],
      "properties": {
        "facts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "\\S"
          }
        },
        "hypotheses": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "\\S"
          }
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "strategy": {
      "type": "object",
      "required": [],
      "properties": {
        "proposals": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "\\S"
          }
        },
        "notes": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
