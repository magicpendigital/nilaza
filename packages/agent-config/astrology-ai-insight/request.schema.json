{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nilaza.local/contracts/astrology-ai-insight/request/1.0.0",
  "title": "Nilaza Astrology AI insight request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "reportId",
    "language",
    "chart",
    "selectedFactIds",
    "facts",
    "caveats",
    "userFocus"
  ],
  "properties": {
    "schemaVersion": {
      "const": "nilaza.astrology.ai-insight.request.v1"
    },
    "requestId": {
      "$ref": "#/definitions/opaqueId"
    },
    "reportId": {
      "$ref": "#/definitions/opaqueId"
    },
    "language": {
      "enum": [
        "vi",
        "en"
      ]
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "contractVersion",
        "calculationVersion",
        "reportRevision",
        "calculationStatus"
      ],
      "properties": {
        "contractId": {
          "const": "nilaza.astrology.canonical-chart"
        },
        "contractVersion": {
          "const": "0.2.0"
        },
        "calculationVersion": {
          "const": "nilaza-a3-utc-tt-2"
        },
        "reportRevision": {
          "type": "integer",
          "minimum": 1
        },
        "calculationStatus": {
          "const": "candidate"
        }
      }
    },
    "selectedFactIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/factId"
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "placements",
        "aspects",
        "houses"
      ],
      "properties": {
        "placements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/placementFact"
          }
        },
        "aspects": {
          "type": "array",
          "maxItems": 45,
          "items": {
            "$ref": "#/definitions/aspectFact"
          }
        },
        "houses": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "$ref": "#/definitions/houseFact"
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/definitions/caveat"
      }
    },
    "userFocus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "theme",
        "sanitizedQuestion",
        "consentScope",
        "contextDisclosure"
      ],
      "properties": {
        "mode": {
          "enum": [
            "overview",
            "question"
          ]
        },
        "theme": {
          "$ref": "#/definitions/focusTheme"
        },
        "sanitizedQuestion": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 500
        },
        "consentScope": {
          "const": "current_focus_only"
        },
        "contextDisclosure": {
          "const": "chart_facts_and_current_focus_only"
        }
      }
    }
  },
  "definitions": {
    "opaqueId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "factId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 96,
      "pattern": "^(placement|aspect|house)\\.[a-z0-9][a-z0-9._-]*$"
    },
    "caveatId": {
      "type": "string",
      "minLength": 5,
      "maxLength": 96,
      "pattern": "^caveat\\.[a-z0-9][a-z0-9._-]*$"
    },
    "sign": {
      "enum": [
        "aries",
        "taurus",
        "gemini",
        "cancer",
        "leo",
        "virgo",
        "libra",
        "scorpio",
        "sagittarius",
        "capricorn",
        "aquarius",
        "pisces"
      ]
    },
    "body": {
      "enum": [
        "sun",
        "moon",
        "mercury",
        "venus",
        "mars",
        "jupiter",
        "saturn",
        "uranus",
        "neptune",
        "pluto",
        "ascendant",
        "midheaven"
      ]
    },
    "focusTheme": {
      "enum": [
        "identity",
        "relationships",
        "work",
        "decision",
        "patterns",
        "open_reflection"
      ]
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "basis",
        "caveatIds"
      ],
      "properties": {
        "level": {
          "enum": [
            "stable",
            "estimated",
            "uncertain",
            "unavailable"
          ]
        },
        "basis": {
          "enum": [
            "deterministic_exact_input",
            "deterministic_approximate_input",
            "sampled_unknown_time",
            "derived_from_chart",
            "missing_required_input"
          ]
        },
        "caveatIds": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/caveatId"
          }
        }
      }
    },
    "placementFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "body",
        "sign",
        "degree",
        "house",
        "retrograde",
        "confidence"
      ],
      "properties": {
        "factId": {
          "$ref": "#/definitions/factId"
        },
        "body": {
          "$ref": "#/definitions/body"
        },
        "sign": {
          "$ref": "#/definitions/sign"
        },
        "degree": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 30
        },
        "house": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "retrograde": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    },
    "aspectFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "bodyA",
        "bodyB",
        "aspectType",
        "orb",
        "confidence"
      ],
      "properties": {
        "factId": {
          "$ref": "#/definitions/factId"
        },
        "bodyA": {
          "$ref": "#/definitions/body"
        },
        "bodyB": {
          "$ref": "#/definitions/body"
        },
        "aspectType": {
          "enum": [
            "conjunction",
            "sextile",
            "square",
            "trine",
            "opposition"
          ]
        },
        "orb": {
          "type": "number",
          "minimum": 0,
          "maximum": 6
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    },
    "houseFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factId",
        "house",
        "sign",
        "confidence"
      ],
      "properties": {
        "factId": {
          "$ref": "#/definitions/factId"
        },
        "house": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "sign": {
          "$ref": "#/definitions/sign"
        },
        "confidence": {
          "$ref": "#/definitions/confidence"
        }
      }
    },
    "caveat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "severity",
        "appliesToFactIds"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/caveatId"
        },
        "code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z0-9][a-z0-9_]*$"
        },
        "severity": {
          "enum": [
            "blocking",
            "warning",
            "info"
          ]
        },
        "appliesToFactIds": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/factId"
          }
        }
      }
    }
  }
}
